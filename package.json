{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "bun dist/src/main.js",
    "test:unit": "bun test tests/money.bun.test.mjs",
    "test:node": "node --test tests/*.test.cjs",
    "test:integration": "bun run build && bun test tests/integration",
    "test:concurrency": "bun run build && bun test tests/integration/concurrency.test.js",
    "migration:up": "bun run build && bun dist/src/migrate.js",
    "migration:down": "bun run build && bun dist/src/migrate-down.js"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/migrations": "^6.4.16",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.16",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/terminus": "^10.2.3",
    "@aws-sdk/client-sqs": "^3.883.0",
    "decimal.js": "^10.5.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.16",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
